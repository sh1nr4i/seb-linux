<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Safe Exam Browser for Linux</vendor>
  <vendor_url>https://safeexambrowser.org</vendor_url>

  <action id="org.safeexambrowser.lockdown.exec">
    <description>Activate Safe Exam Browser exam lockdown</description>
    <message>Safe Exam Browser requires administrator privileges to enable secure exam anti-cheat lockdown.</message>
    <icon_name>safe-exam-browser</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/safe-exam-browser-lockdown</annotate>
  </action>
</policyconfig>
